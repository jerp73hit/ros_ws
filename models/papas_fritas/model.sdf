<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="papas_fritas_bicolor">
    <static>false</static>
    
    <link name="basket_link">
      
      <inertial>
        <pose>0 0 0.04 0 0 0</pose>
        <mass>0.19</mass>
        <inertia>
          <ixx>0.000406</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.000406</iyy> <iyz>0.0</iyz>
          <izz>0.00025</izz>
        </inertia>
      </inertial>

      <velocity_decay>
        <linear>0.05</linear>
        <angular>0.05</angular>
      </velocity_decay>

      <collision name="collision_volumen">
        <pose>0 0 0.04 0 0 0</pose> 
        <geometry>
          <box>
            <size>0.08 0.08 0.08</size>
          </box>
        </geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          <contact><ode><kp>100000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>

      <visual name="visual_canasta">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://papas_fritas/meshes/basket_v2.stl</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <link name="potatoes_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.000001</iyy> <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <visual name="visual_papas">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://papas_fritas/meshes/potato_block_v2.stl</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name="glue_joint" type="fixed">
      <parent>basket_link</parent>
      <child>potatoes_link</child>
    </joint>

  </model>
</sdf>
