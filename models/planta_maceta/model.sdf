<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="planta_maceta">
    <static>false</static>
    <link name="base_link">
      
      <inertial>
        <pose>0 0 0.05 0 0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0004375</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.0004375</iyy> <iyz>0.0</iyz>
          <izz>0.000375</izz>
        </inertia>
      </inertial>

      <collision name="collision_maceta">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

     <visual name="visual_planta">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://planta_maceta/meshes/planta.stl</uri>
            <scale>0.4 0.4 0.4</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name> </script>
        </material>
      </visual>

    </link>
  </model>
</sdf>
