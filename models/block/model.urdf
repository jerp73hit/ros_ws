<robot name="block">
  <link name="block">
    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="0.5" />
      <inertia ixx="0.000075" ixy="0.0" ixz="0.0" iyy="0.000075" iyz="0.0" izz="0.000075" />
    </inertial>
    
    <visual>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.04 0.04 0.04" />
      </geometry>
    </visual>
    
    <collision>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.04 0.04 0.04" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="block">
    <material>Gazebo/Red</material>
    <mu1>1000</mu1>
    <mu2>1000</mu2>
  </gazebo>
</robot>
