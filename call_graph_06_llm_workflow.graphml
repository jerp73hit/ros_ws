            System prompt enforces:
          </y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Arial" fontSize="10" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" height="167.43984985351562" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#5A4F3E" verticalTextPosition="bottom" visible="true" width="172.36868286132812" x="53.81565856933594" xml:space="preserve" y="11.280075073242188">
            • Top-down grasps:
              roll = 180°, pitch = 0°
            • 20 cm hover above target
              (collision avoidance)
            • Spatial prepositions
              (left of, inside, behind…)
              → explicit coordinate offsets
            • Multi-object tasks:
              auto 6-step pick-and-place
              cycles per object
          </y:NodeLabel>
          <y:Shape type="rectangle3d"/>
        </y:ShapeNode>
      </data>
