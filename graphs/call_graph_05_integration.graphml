<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:java="http://www.yworks.com/xml/yfiles-common/1.0/java" xmlns:sys="http://www.yworks.com/xml/yfiles-common/markup/primitives/2.0" xmlns:x="http://www.yworks.com/xml/yfiles-common/markup/2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:y="http://www.yworks.com/xml/graphml" xmlns:yed="http://www.yworks.com/xml/yed/3" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://www.yworks.com/xml/schema/graphml/1.1/ygraphml.xsd">
  <!-- Pick & Place Flowchart in English Pseudocode with Call Graph 3 Styles -->
  <key for="port" id="d0" yfiles.type="portgraphics"/>
  <key for="port" id="d1" yfiles.type="portgeometry"/>
  <key for="port" id="d2" yfiles.type="portuserdata"/>
  <key attr.name="url" attr.type="string" for="node" id="d3"/>
  <key attr.name="description" attr.type="string" for="node" id="d4"/>
  <key for="node" id="d5" yfiles.type="nodegraphics"/>
  <key for="graphml" id="d6" yfiles.type="resources"/>
  <key attr.name="url" attr.type="string" for="edge" id="d7"/>
  <key attr.name="description" attr.type="string" for="edge" id="d8"/>
  <key for="edge" id="d9" yfiles.type="edgegraphics"/>
  <graph edgedefault="directed" id="G">
    
    <!-- n0: SIMULATION -->
    <node id="n0">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="95.0" width="410.0" x="50.0" y="50.0"/>
          <y:Fill color="#D6EAE0" transparent="false"/>
          <y:BorderStyle color="#7FADA0" type="line" width="1.2"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" backgroundColor="#7FADA0" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="sides" modelPosition="w" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="85.0" x="-89.0" xml:space="preserve" y="37.5">SIMULATION</y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="85.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#3A6858" verticalTextPosition="bottom" visible="true" width="380.0" x="15.0" xml:space="preserve" y="5.0">START Virtual_Environment (Gazebo)
START Robot_Model (Sawyer)
GENERATE Environment_Objects (9 elements)
MOVE Robot to Safe_Initial_Pose
ACTIVATE Communication_Channels (ROS)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- n1: INPUT -->
    <node id="n1">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="70.0" width="410.0" x="50.0" y="200.0"/>
          <y:Fill color="#E2DCF0" transparent="false"/>
          <y:BorderStyle color="#9B90C4" type="line" width="1.2"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" backgroundColor="#9B90C4" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="sides" modelPosition="w" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="50.0" x="-54.0" xml:space="preserve" y="25.0">INPUT</y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="58.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#4A3F78" verticalTextPosition="bottom" visible="true" width="380.0" x="15.0" xml:space="preserve" y="6.0">READ User_Command (Natural Language Text)
SEND Task_Description to LLM_Client</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- n2: LLM GEN -->
    <node id="n2">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="100.0" width="410.0" x="50.0" y="330.0"/>
          <y:Fill color="#F5DDD6" transparent="false"/>
          <y:BorderStyle color="#C4907F" type="line" width="1.2"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" backgroundColor="#C4907F" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="sides" modelPosition="w" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="65.0" x="-69.0" xml:space="preserve" y="40.0">LLM GEN</y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="99.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#7A3F2E" verticalTextPosition="bottom" visible="true" width="380.0" x="15.0" xml:space="preserve" y="0.5">LOAD API_Contract_Rules + Instructions
PROCESS with Local_LLM (Qwen2.5-Coder)
GENERATE Execution_Script (Python)
DYNAMICALLY IMPORT &amp; EXECUTE Task Routine</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- n3: PERCEPTION -->
    <node id="n3">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="95.0" width="410.0" x="535.0" y="332.5"/>
          <y:Fill color="#F5E6EC" transparent="false"/>
          <y:BorderStyle color="#C4A0AF" type="line" width="1.2"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" backgroundColor="#C4A0AF" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="sides" modelPosition="e" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="85.0" x="414.0" xml:space="preserve" y="37.5">PERCEPTION</y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="85.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#7A4055" verticalTextPosition="bottom" visible="true" width="380.0" x="15.0" xml:space="preserve" y="5.0">DETECT Objects within Scene (YOLOv8)
MAP 2D Bounding Boxes to 3D World Coordinates
BACK-PROJECT using Camera Intrinsics + Depth Data
RETURN Target_List { Object : Position(X, Y, Z, Yaw) }</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- n4: MOTION -->
    <node id="n4">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="105.0" width="410.0" x="535.0" y="490.0"/>
          <y:Fill color="#F5E6EC" transparent="false"/>
          <y:BorderStyle color="#C4A0AF" type="line" width="1.2"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" backgroundColor="#C4A0AF" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="sides" modelPosition="e" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="60.0" x="414.0" xml:space="preserve" y="42.5">MOTION</y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="99.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#7A4055" verticalTextPosition="bottom" visible="true" width="380.0" x="15.0" xml:space="preserve" y="3.0">PLAN L-Shaped Approach Trajectory
APPLY Pre-Grasp Safety Offset Distance
SOLVE Inverse Kinematics (TRAC-IK Solver)
CONVERT to Joint Position Commands for Motors
EXECUTE: Close Gripper → Lift → Transfer → Open</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- n5: ROBOT -->
    <node id="n5">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="65.0" width="410.0" x="535.0" y="660.0"/>
          <y:Fill color="#F5E6EC" transparent="false"/>
          <y:BorderStyle color="#C4A0AF" type="line" width="1.2"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" backgroundColor="#C4A0AF" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="sides" modelPosition="e" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="50.0" x="414.0" xml:space="preserve" y="22.5">ROBOT</y:NodeLabel>
          <y:NodeLabel alignment="left" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="58.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#7A4055" verticalTextPosition="bottom" visible="true" width="380.0" x="15.0" xml:space="preserve" y="3.5">PUBLISH Hardware Joint Positions via ROS
CONTROL Physical Gripper Actuator States</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- n6: FINISH -->
    <node id="n6">
      <data key="d5">
        <y:ShapeNode>
          <y:Geometry height="40.0" width="220.0" x="630.0" y="775.0"/>
          <y:Fill color="#C4A0AF" transparent="false"/>
          <y:BorderStyle color="#7A4055" type="line" width="1.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="11" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" height="20.0" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#FFFFFF" verticalTextPosition="bottom" visible="true" width="180.0" x="20.0" xml:space="preserve" y="10.0">✓ Pick &amp; Place Complete</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- EDGES -->
    <edge id="e0" source="n0" target="n1">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#9B90C4" type="dashed" width="1.2"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

    <edge id="e1" source="n1" target="n2">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#4A3F78" type="line" width="1.5"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

    <edge id="e2" source="n2" target="n3">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#C4907F" type="line" width="1.5"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

    <edge id="e3" source="n3" target="n4">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#C4A0AF" type="line" width="1.5"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

    <edge id="e4" source="n4" target="n5">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#C4A0AF" type="line" width="1.5"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

    <edge id="e5" source="n5" target="n6">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#7A4055" type="line" width="1.5"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

    <edge id="e6" source="n0" target="n3">
      <data key="d9">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0">
            <y:Point x="740.0" y="97.5"/>
          </y:Path>
          <y:LineStyle color="#7FADA0" type="line" width="1.5"/>
          <y:Arrows source="none" target="standard"/>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>

  </graph>
  <data key="d6">
    <y:Resources/>
