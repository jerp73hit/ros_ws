<launch>
    <!-- ========================================================= -->
    <!--  Sawyer Gazebo + Vision Scene Launch                     -->
    <!--  Workspace: ~/ros_ws_team                                -->
    <!--  Package: python_scripts_v1                              -->
    <!-- ========================================================= -->

    <!-- Gazebo must know where the custom models are located -->
    <env name="GAZEBO_MODEL_PATH"
         value="$(env HOME)/ros_ws_team/models:$(optenv GAZEBO_MODEL_PATH)" />

    <!-- ========================================================= -->
    <!-- 1. Start Sawyer simulation in Gazebo with electric gripper -->
    <!-- ========================================================= -->
    <include file="$(find sawyer_gazebo)/launch/sawyer_world.launch">
        <arg name="electric_gripper" value="true"/>
    </include>

    <!-- ========================================================= -->
    <!-- 2. Open Gazebo GUI                                       -->
    <!--    Delay prevents gzclient from opening before gzserver   -->
    <!-- ========================================================= -->
    <node pkg="gazebo_ros"
          type="gzclient"
          name="gzclient"
          output="screen"
          launch-prefix="bash -c 'sleep 5; exec $0 $@'"/>

    <!-- ========================================================= -->
    <!-- 3. Spawn table and objects in Gazebo                      -->
    <!--    Uses models from ~/ros_ws_team/models                  -->
    <!-- ========================================================= -->
    <node pkg="python_scripts_v1"
          type="spawn_pick_place_scene.py"
          name="spawn_pick_place_scene"
          output="screen"
          respawn="false"
          launch-prefix="bash -c 'sleep 8; exec $0 $@'"/>

    <!-- ========================================================= -->
    <!-- 4. Send Sawyer to safe initial pose                       -->
    <!--    Runs after Gazebo and objects are loaded               -->
    <!-- ========================================================= -->
    <node pkg="python_scripts_v1"
          type="send_safe_pose.py"
          name="send_safe_pose"
          output="screen"
          respawn="false"
          launch-prefix="bash -c 'sleep 12; exec $0 $@'"/>

    <!-- ========================================================= -->
    <!-- 5. Optional: move arm to top hand-camera pose             -->
    <!--    Uncomment this only when you want the robot to move    -->
    <!--    automatically to the vision/camera observation pose.   -->
    <!-- ========================================================= -->

    <!--
    <node pkg="python_scripts_v1"
          type="go_to_top_hand_camera_pos.py"
          name="go_to_top_hand_camera_pos"
          output="screen"
          respawn="false"
          launch-prefix="bash -c 'sleep 16; exec $0 $@'"/>
    -->

</launch>
