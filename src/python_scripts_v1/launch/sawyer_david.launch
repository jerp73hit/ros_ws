<launch>
    <!-- ========================================================= -->
    <!-- Sawyer Gazebo + Pick and Place Scene Launch               -->
    <!-- Package: python_scripts_v1                                -->
    <!-- Neutral path: repo/models is found relative to package     -->
    <!-- ========================================================= -->

    <!-- ========================================================= -->
    <!-- Custom Gazebo models                                      -->
    <!-- Expected repository layout:                               -->
    <!--   repo/                                                   -->
    <!--   ├── models/                                             -->
    <!--   └── src/python_scripts_v1                               -->
    <!-- ========================================================= -->
    <env name="GAZEBO_MODEL_PATH"
         value="$(find python_scripts_v1)/../../models:$(optenv GAZEBO_MODEL_PATH)" />

    <!-- ========================================================= -->
    <!-- 1. Start Sawyer simulation in Gazebo with electric gripper -->
    <!-- ========================================================= -->
    <include file="$(find sawyer_gazebo)/launch/sawyer_world.launch">
        <arg name="electric_gripper" value="true"/>
    </include>

    <!-- ========================================================= -->
    <!-- 2. Open Gazebo GUI                                        -->
    <!-- Delay prevents gzclient from opening before gzserver       -->
    <!-- ========================================================= -->
    <node pkg="gazebo_ros"
          type="gzclient"
          name="gzclient"
          output="screen"
          launch-prefix="bash -c 'sleep 8; exec $0 $@'"/>

    <!-- ========================================================= -->
    <!-- 3. Spawn table and objects                                -->
    <!-- The script must locate models using package-relative path  -->
    <!-- or GAZEBO_MODEL_PATH, not ./models                         -->
    <!-- ========================================================= -->
    <node pkg="python_scripts_v1"
          type="spawn_pick_place_scene.py"
          name="spawn_pick_place_scene"
          output="screen"
          respawn="false"
          launch-prefix="bash -c 'sleep 18; exec $0 $@'"/>

    <!-- ========================================================= -->
    <!-- 4. Send Sawyer to safe initial pose                       -->
    <!-- Give the scene time to spawn before moving the arm         -->
    <!-- ========================================================= -->
    <node pkg="python_scripts_v1"
          type="send_safe_pose.py"
          name="send_safe_pose"
          output="screen"
          respawn="false"
          launch-prefix="bash -c 'sleep 35; exec $0 $@'"/>

    <!-- ========================================================= -->
    <!-- 5. Move arm to top hand-camera pose                       -->
    <!-- Must run after safe pose has fully finished                -->
    <!-- ========================================================= -->
    <node pkg="python_scripts_v1"
          type="go_to_top_hand_camera_pos.py"
          name="go_to_top_hand_camera_pos"
          output="screen"
          respawn="false"
          launch-prefix="bash -c 'sleep 70; exec $0 $@'"/>

</launch>
